flowchart LR
  classDef web fill:#eef2ff,stroke:#6366f1,color:#1e1b4b
  classDef db fill:#ecfdf5,stroke:#10b981,color:#064e3b
  classDef fn fill:#fef3c7,stroke:#d97706,color:#78350f
  classDef off fill:#f3f4f6,stroke:#6b7280,color:#111827
